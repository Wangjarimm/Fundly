# Salin ke .env untuk pengembangan lokal. Jangan isi nilai produksi di laptop.
# Nilai produksi hanya diisi di Vercel → Settings → Environment Variables.

# Postgres lokal dari docker-compose.yml
DATABASE_URL=postgres://fundly:fundly@localhost:5432/fundly?sslmode=disable
# Database khusus tes integrasi (dibuat otomatis oleh scripts/db-init)
TEST_DATABASE_URL=postgres://fundly:fundly@localhost:5432/fundly_test?sslmode=disable

# Port server lokal (Vercel mengisi PORT sendiri)
PORT=8080

# Ukuran pool pgx per instance (D-13: kecil, 1–3 di produksi)
DB_MAX_CONNS=3

# Menandatangani state OAuth; minimal 32 karakter. Tanpa ini login Google nonaktif.
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# Kosongkan untuk menonaktifkan login Google di lokal
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opsional: basis URL publik untuk redirect OAuth (produksi: https://fundly-six.vercel.app)
APP_BASE_URL=
